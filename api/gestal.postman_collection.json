{
  "info": {
    "name": "Gestal API",
    "description": "Endpoints del MVP de Gestal (login, categorias y solicitudes).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "solicitudId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (estudiante)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"ana.torres@example.edu\",\n  \"contrasena\": \"gestal123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login (supervisor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"maria.vega@example.edu\",\n  \"contrasena\": \"gestal123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Catalogos",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categorias"]
            }
          }
        },
        {
          "name": "Listar prioridades",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/prioridades",
              "host": ["{{baseUrl}}"],
              "path": ["api", "prioridades"]
            }
          }
        }
      ]
    },
    {
      "name": "Solicitudes",
      "item": [
        {
          "name": "Listar solicitudes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "solicitudes"]
            }
          }
        },
        {
          "name": "Obtener solicitud",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{solicitudId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "solicitudes", "{{solicitudId}}"]
            }
          }
        },
        {
          "name": "Registrar solicitud",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "solicitudes"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoriaId\": 1,\n  \"descripcion\": \"El proyector del laboratorio no enciende\",\n  \"ubicacion\": \"Laboratorio 204 - Pabellon nuevo\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Actualizar solicitud (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{solicitudId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "solicitudes", "{{solicitudId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoriaId\": 1,\n  \"descripcion\": \"El proyector no enciende ni con otro cable\",\n  \"ubicacion\": \"Laboratorio 204 - Pabellon nuevo\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Cambiar estado (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{solicitudId}}/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "solicitudes", "{{solicitudId}}", "estado"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN_PROCESO\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Asignar responsable (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{solicitudId}}/responsable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "solicitudes", "{{solicitudId}}", "responsable"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responsableId\": 2,\n  \"prioridad\": \"ALTA\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Eliminar solicitud (DELETE, admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{solicitudId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "solicitudes", "{{solicitudId}}"]
            }
          }
        }
      ]
    }
  ]
}
